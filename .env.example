# --- Required ---
# PostgreSQL connection string (docker compose up -d starts a matching local DB)
DATABASE_URL="postgresql://dconnect:dconnect@localhost:5432/dconnect?schema=public"
# Signs session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=
# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Google Maps (needs your own Google Cloud project + billing) ---
# Browser key: enable "Maps JavaScript API". Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management). Falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server key: enable "Distance Matrix API". Restrict by server IP. Never expose to the browser.
GOOGLE_MAPS_SERVER_KEY=

# --- AI assistant (optional; /api/ai returns 501 when empty) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
